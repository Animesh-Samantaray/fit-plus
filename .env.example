# ==========================================
# HB+ Application Environment Variables
# ==========================================
# Copy this file to .env and replace placeholder values.
# IMPORTANT: Never commit .env to version control.

# Application Configuration
EXPO_PUBLIC_APP_NAME=HB+
EXPO_PUBLIC_APP_ENV=production

# Strict Allowed Email Domain for Google Sign-In
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=hbplus.fit

# Firebase Web App Configuration
# Obtain from Firebase Console > Project Settings > General > Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Google OAuth Client IDs
# Obtain from Google Cloud Console > APIs & Services > Credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Administrative Token (Used only for server-side API verification)
ADMIN_INVITE_TOKEN=your-secure-admin-token
